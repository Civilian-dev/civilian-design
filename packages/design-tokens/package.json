{
  "name": "@civilian-dev/design-tokens",
  "version": "0.0.0",
  "description": "Civilian design tokens, synced from Figma",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": "./dist/tokens.css",
    "./json": "./dist/tokens.json",
    "./resolved": {
      "types": "./dist/resolved.d.ts",
      "default": "./dist/resolved.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Civilian-dev/civilian-design.git",
    "directory": "packages/design-tokens"
  },
  "devDependencies": {
    "@terrazzo/parser": "2.10.0",
    "@types/node": "26.6.6",
    "lightningcss": "1.33.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "scripts": {
    "normalise": "tsx scripts/normalise.ts",
    "build": "tsx scripts/build.ts",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "token-diff": "tsx scripts/token-diff.ts"
  }
}
