{
  "name": "@civilian-dev/design-tokens",
  "version": "0.0.0",
  "description": "Civilian design tokens, synced from Figma",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
