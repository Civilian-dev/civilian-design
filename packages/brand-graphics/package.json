{
  "name": "@civilian-dev/brand-graphics",
  "version": "0.2.0",
  "description": "Civilian brand graphics: a small shape kit and a composer for banners, social images and backgrounds",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./compose": {
      "types": "./dist/compose.d.ts",
      "default": "./dist/compose.js"
    },
    "./raster": {
      "types": "./dist/raster.d.ts",
      "default": "./dist/raster.js"
    },
    "./patterns.css": "./dist/patterns.css",
    "./shapes/*": "./dist/shapes/*",
    "./mark/*": "./dist/mark/*"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Civilian-dev/civilian-design.git",
    "directory": "packages/brand-graphics"
  },
  "scripts": {
    "build": "tsx scripts/prepare.ts && tsc -p tsconfig.build.json && tsx scripts/build.ts && tsx scripts/seeds.ts",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@civilian-dev/brand-fonts": "workspace:^",
    "@civilian-dev/design-tokens": "workspace:^",
    "@resvg/resvg-js": "2.6.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
